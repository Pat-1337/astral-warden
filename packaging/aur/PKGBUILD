# Maintainer: patvuk <https://github.com/patvuk>

pkgname=gpu-warden-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='Per-pin 12V-2x6 watchdog for ASUS ROG Astral and Matrix GPUs and the WireView Pro II'
arch=('x86_64')
url='https://github.com/patvuk/gpu-warden'
license=('MIT')
depends=('glibc')
optdepends=('nvidia-utils: GPU power cap through NVML' 'libnotify: desktop notifications')
provides=('gpu-warden')
conflicts=('gpu-warden')
backup=('etc/gpu-warden/config.toml')
install=gpu-warden.install
source_x86_64=("$url/releases/download/v$pkgver/gpu-warden-v$pkgver-linux-$CARCH-systemd.tar.gz")
sha256sums_x86_64=('SKIP')

package() {
  cd "gpu-warden-v$pkgver-linux-$CARCH-systemd"

  install -Dm755 gpu-warden "$pkgdir/usr/bin/gpu-warden"
  install -Dm644 init/modules-load.conf "$pkgdir/usr/lib/modules-load.d/gpu-warden.conf"
  install -Dm644 init/udev.rules "$pkgdir/usr/lib/udev/rules.d/70-gpu-warden.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  install -d "$pkgdir/usr/lib/systemd/system" "$pkgdir/etc/gpu-warden"
  sed -e 's|@BIN@|/usr/bin/gpu-warden|' -e 's|@CONFIG@|/etc/gpu-warden/config.toml|' \
    init/gpu-warden.service > "$pkgdir/usr/lib/systemd/system/gpu-warden.service"
  ./gpu-warden config > "$pkgdir/etc/gpu-warden/config.toml"
}
